</mxCell><mxCell id="1-89" value="reads, as&#10;vennir_gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" parent="1" source="1-30" target="1-22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="575" y="685"/><mxPoint x="575" y="405"/></Array><mxPoint x="10" y="70" as="offset"/></mxGeometry></mxCell><mxCell id="1-90" value="forwards checked&#10;requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;dashed=1;" edge="1" parent="1" source="1-30" target="1-43"><mxGeometry relative="1" as="geometry"><mxPoint x="-90" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="1-91" value="API calls&#10;(not exposed here)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.000;exitY=0.900;entryX=0.500;entryY=1.000;dashed=1;" edge="1" parent="1" source="1-5" target="1-30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="424"/><mxPoint x="345" y="775"/><mxPoint x="690" y="775"/></Array><mxPoint x="125" y="105" as="offset"/></mxGeometry></mxCell><mxCell id="1-92" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.000;exitY=0.409;entryX=0.000;entryY=0.682;" edge="1" parent="1" source="1-37" target="1-64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-93" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;" edge="1" parent="1" source="1-62" target="1-64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1-94" value="push + sign (KMS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.500;exitY=0.000;entryX=1.000;entryY=0.500;" edge="1" parent="1" source="1-7" target="1-64"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="60"/><mxPoint x="1960" y="60"/><mxPoint x="1960" y="345"/></Array></mxGeometry></mxCell><mxCell id="1-95" value="writes Secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.554;exitY=0.000;entryX=0.581;entryY=1.000;" edge="1" parent="1" source="1-58" target="1-45"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="55" as="offset"/></mxGeometry></mxCell><mxCell id="1-96" value="signature webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.793;exitY=1.000;entryX=0.286;entryY=0.000;" edge="1" parent="1" source="1-45" target="1-60"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="55" as="offset"/></mxGeometry></mxCell><mxCell id="1-97" value="verify signature" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" parent="1" source="1-60" target="1-66"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="1090"/><mxPoint x="1560" y="485"/></Array></mxGeometry></mxCell><mxCell id="1-98" value="read (Workload Identity)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#444444;exitX=0.500;exitY=1.000;entryX=0.000;entryY=0.500;" edge="1" parent="1" source="1-58" target="1-68"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="1190"/><mxPoint x="1575" y="1190"/><mxPoint x="1575" y="595"/></Array></mxGeometry></mxCell><mxCell id="1-99" value="One execution, in order: ① A person or pipeline calls the console, which checks team membership, identity, team secrets and images. ② The console forwards the DAG to kernel-api, which validates it and stores it (PENDING). ③ kernel-scheduler claims READY tasks&#10;from Postgres. ④ For each, it creates a ConfigMap holding request.json, and a Job, through the API server, whose admission policies can refuse them (DISPATCH_REJECTED, IMAGE_NOT_ALLOWED, IMAGE_NOT_SIGNED, IDENTITY_NOT_ALLOWED). ⑤ The Pod runs as its product's&#10;ServiceAccount with the team Secrets its step lists and writes result.json; the scheduler reads it, stores outputs and logs, releases the tasks that waited on it, and once that's committed deletes the Job. kernel-api and kernel-scheduler never call each other:&#10;Postgres rows are their only channel. Where the gateway is on (the kind values; not vennir-gke, so it's dashed), an API product is called through execution-gateway instead, which forwards only what its reviewed OpenAPI document describes, to its backend." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fffbe6;strokeColor=#d6b656;html=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1280" width="1920" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="2 · Kernel types"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2-2" value="Kernel (kernel/cmd, kernel/internal; Go): every file, type and function" style="text;align=left;verticalAlign=middle;html=0;fontFamily=Helvetica;fontSize=12;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="2-3" value="Generated from the source by docs/architecture/generate.py.  + exported, - unexported.  An interface lists its methods; a struct its fields." style="text;align=left;verticalAlign=middle;html=0;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1800" height="24" as="geometry"/></mxCell><mxCell id="2-4" value="Dashed arrows above: «import». The package at the tail imports the package at the head." style="text;align=left;verticalAlign=middle;html=0;fontFamily=Helvetica;fontSize=12;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="700" height="20" as="geometry"/></mxCell><mxCell id="2-5" value="internal/domain/  (rules, no I/O)" style="rounded=1;arcSize=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;dashed=1;html=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="376" width="910" height="1519" as="geometry"/></mxCell><mxCell id="2-6" value="«file»&#10;internal/domain/credentials.go" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#ffffff;strokeColor=#666666;swimlaneFillColor=#ffffff;html=0;fontFamily=Helvetica;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="398" height="93" as="geometry"/></mxCell><mxCell id="2-7" value="+ RedactText(text): string&#10;+ RedactLines(lines): []string&#10;+